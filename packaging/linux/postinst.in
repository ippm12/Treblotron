#!/bin/sh
# Generated from postinst.in -- edit the template, never the copy in the
# build tree. The paths are substituted from CMake so they cannot drift
# from where install() actually puts things, which is a failure that shows
# up as a package that installs cleanly and provides no command.
#
# Files live under the package prefix, which is outside $PATH and outside the
# places a desktop environment looks. Link them into both so the package
# behaves like something installed rather than something unpacked.
#
# Every conditional below is an `if`, not `[ ... ] && cmd`. Under `set -e` an
# AND-list whose test fails returns non-zero and takes the script with it, so
# the shorter form turns "the file is not there" into a failed package
# configuration.
set -e

BIN=@DEB_BIN@
LINK=@DEB_LINK@
DESKTOP=@DEB_DESKTOP@
DESKTOP_LINK=@DEB_DESKTOP_LINK@

case "$1" in
    configure)
        if [ -x "$BIN" ]; then
            ln -sf "$BIN" "$LINK"
        else
            echo "treblotron: expected the binary at $BIN, but it is not there;" >&2
            echo "treblotron: no $LINK command was created." >&2
        fi

        if [ -f "$DESKTOP" ]; then
            mkdir -p /usr/share/applications
            ln -sf "$DESKTOP" "$DESKTOP_LINK"
            if command -v update-desktop-database >/dev/null 2>&1; then
                update-desktop-database -q /usr/share/applications || true
            fi
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
