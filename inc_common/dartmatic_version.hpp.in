/**
 * dartmatic_version.hpp.in
 *
 * Template for the generated version header. CMake substitutes the values from
 * project(VERSION ...) at configure time; edit the version there, never here.
 *
 * The generated copy lands in ${PROJECT_BINARY_DIR}/generated and is on every
 * target's include path.
 */

#ifndef DARTMATIC_VERSION_HPP
#define DARTMATIC_VERSION_HPP

#define DARTMATIC_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define DARTMATIC_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define DARTMATIC_VERSION_PATCH @PROJECT_VERSION_PATCH@

/** e.g. "0.1.0" */
#define DARTMATIC_VERSION_STRING "@PROJECT_VERSION@"

/** Product name, so the window title and installer cannot drift apart. */
#define DARTMATIC_PRODUCT_NAME "Dartmatic"

#endif // DARTMATIC_VERSION_HPP
